# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_DATABASE=news_aggregator

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# LLM (optional - enables AI summarization & rewriting)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-3.5-turbo

# Email (optional - enables subscription emails)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@newsaggregator.com

# Site
SITE_TITLE=Global News Digest
SITE_BASEURL=https://your-domain.com
DIST_DIR=./dist
CORS_ORIGINS=*

# SSL (Let's Encrypt)
CERTBOT_EMAIL=admin@your-domain.com

# Fetcher
UPDATE_INTERVAL=15
CONTENT_ENRICHMENT=true
ENRICHMENT_CONCURRENT=3

# Telegram Bot (required for Telegram push notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Push Scheduler
PUSH_CHECK_INTERVAL=60
ARTICLES_PER_PUSH=10
DEFAULT_TIMEZONE=UTC

# Ads (optional - enables Google AdSense)
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
